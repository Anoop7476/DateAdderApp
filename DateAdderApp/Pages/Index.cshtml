@page
@{
    ViewData["Title"] = "Home page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Date Adder</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="date-adder-body">
    <div class="card">
        <h1>Date Adder</h1>

        <div class="field">
            <label for="startDate">Start date</label>
            <input id="startDate" type="text" placeholder="dd/mm/yyyy" maxlength="10" autocomplete="off">
            <div class="hint">Format: dd/mm/yyyy</div>
            <div class="err" id="dateErr"></div>
        </div>

        <div class="field">
            <label for="days">Days to add</label>
            <input id="days" type="number" placeholder="e.g. 30">
            <div class="err" id="daysErr"></div>
        </div>

        <button id="calcBtn">Calculate New Date</button>

        <div class="result" id="result">
            <div class="result-label">New Date</div>
            <div class="result-date" id="resultDate"></div>
            <div class="result-meta" id="resultMeta"></div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>

